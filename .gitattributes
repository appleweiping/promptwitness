* text=auto
*.cff text eol=lf
*.in text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.png binary
.gitattributes text eol=lf

# Frozen research evidence uses byte hashes, including its original newlines.
# Do not silently normalize historical files when committing or checking out.
configs/research/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
research/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reproduce/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/reproduce/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
